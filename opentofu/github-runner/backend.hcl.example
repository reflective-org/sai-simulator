# Copy to backend.hcl (gitignored) and fill in your state bucket (required for tofu init).
#
# Region must match the bucket's AWS region or S3 returns PermanentRedirect (301).
# Discover it:
#   aws s3api get-bucket-location --bucket <your-state-bucket>
# If LocationConstraint is null, the bucket is in us-east-1.
#
# Init:
#   tofu init -backend-config=backend.hcl

region = "us-west-2"
bucket = "your-opentofu-state-bucket"
key    = "sai-simulator/github-runner/terraform.tfstate"
