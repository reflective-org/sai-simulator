# Copy to backend.hcl and set region to match reflective-opentofu-state (required for tofu init).
#
# Discover region:
#   aws s3api get-bucket-location --bucket reflective-opentofu-state
# If LocationConstraint is null, the bucket is in us-west-2.
#
# Init:
#   tofu init -backend-config=backend.hcl

region = "us-west-2"
